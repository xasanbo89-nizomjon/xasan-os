// Prisma schema for XASAN OS Ultimate
// Designed for multi-domain productivity, developer workflows, and personal operating system

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  PAUSED
  COMPLETED
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  displayName String
  avatarUrl   String?
  role        String   @default("OWNER")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Data isolation relations
  tasks        Task[]
  habits       Habit[]
  habitLogs    HabitLog[]
  projects     Project[]
  transactions Transaction[]
  notes        KnowledgeNote[]
  goals        Goal[]

  @@map("users")
}

model Task {
  id          String     @id @default(uuid())
  userId      String
  projectId   String?
  title       String
  description String?    @db.Text
  priority    Priority   @default(NORMAL)
  status      TaskStatus @default(PENDING)
  dueDate     DateTime?
  completedAt DateTime?
  tags        String[]   @default([])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, priority])
  @@index([userId, dueDate])
  @@map("tasks")
}

model Habit {
  id               String   @id @default(uuid())
  userId           String
  name             String
  description      String?
  frequency        String   @default("DAILY")
  targetDaysPerWeek Int     @default(7)
  targetCount      Int      @default(1)
  unit             String   @default("times")
  category         String   @default("DISCIPLINE")
  color            String   @default("#10B981")
  streak           Int      @default(0)
  bestStreak       Int      @default(0)
  archived         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs HabitLog[]

  @@index([userId, archived])
  @@map("habits")
}

model HabitLog {
  id          String   @id @default(uuid())
  habitId     String
  userId      String
  date        String   // Format: YYYY-MM-DD for fast index lookup
  completedAt DateTime @default(now())
  count       Int      @default(1)
  notes       String?
  createdAt   DateTime @default(now())

  // Relations
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([userId, date])
  @@map("habit_logs")
}

model Project {
  id            String        @id @default(uuid())
  userId        String
  name          String
  slug          String
  description   String?       @db.Text
  status        ProjectStatus @default(ACTIVE)
  priority      Priority      @default(NORMAL)
  techStack     String[]      @default([])
  repositoryUrl String?
  liveUrl       String?
  progress      Int           @default(0)
  color         String?       @default("#10B981")
  icon          String?
  startDate     DateTime?
  targetDate    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@unique([userId, slug])
  @@index([userId, status])
  @@map("projects")
}

model Transaction {
  id          String          @id @default(uuid())
  userId      String
  title       String
  amount      Decimal         @db.Decimal(12, 2)
  type        TransactionType
  category    String
  account     String          @default("Default Account")
  date        DateTime        @default(now())
  notes       String?         @db.Text
  tags        String[]        @default([])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, date])
  @@index([userId, category])
  @@map("transactions")
}

model KnowledgeNote {
  id         String   @id @default(uuid())
  userId     String
  title      String
  content    String   @db.Text
  summary    String?  @db.Text
  category   String   @default("General")
  tags       String[] @default([])
  isPinned   Boolean  @default(false)
  isFavorite Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
  @@index([userId, isPinned])
  @@map("knowledge_notes")
}

model Goal {
  id          String    @id @default(uuid())
  userId      String
  title       String
  description String?   @db.Text
  category    String    @default("CAREER")
  progress    Int       @default(0)
  targetDate  DateTime?
  isAchieved  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isAchieved])
  @@map("goals")
}
