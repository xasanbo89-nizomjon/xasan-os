// Prisma schema for XASAN OS Ultimate
// Designed for multi-domain productivity, developer workflows, and personal operating system

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

model User {
  id                String    @id @default(uuid())
  firebaseUid       String?   @unique
  email             String    @unique
  displayName       String
  avatarUrl         String?
  role              String    @default("OWNER")
  isPinEnabled      Boolean   @default(false)
  pinHash           String?
  pinLength         Int       @default(4)
  pinFailedAttempts Int       @default(0)
  pinLockedUntil    DateTime?
  lastLoginAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Data isolation relations
  tasks          Task[]
  habits         Habit[]
  habitLogs      HabitLog[]
  wellnessLogs   WellnessLog[]
  projects       Project[]
  transactions   Transaction[]
  notes          KnowledgeNote[]
  goals          Goal[]
  visionItems    VisionItem[]
  journalEntries JournalEntry[]
  sessions       Session[]
  events         CalendarEvent[]
  reminders      Reminder[]
  focusSessions  FocusSession[]
  ieltsRecords   IeltsPracticeRecord[]
  examResults    ExamResult[]
  arabicLogs     ArabicPracticeLog[]
  vocabCards     VocabularyCard[]
  studySessions  StudySession[]
  devBugs        DevBug[]
  devFeatures    DevFeature[]
  devDocs        DevDoc[]
  devDeployments DevDeployment[]
  devReleases    DevRelease[]
  devIntegrationSetting DevIntegrationSetting?
  budgets        Budget[]
  savingsGoals   SavingsGoal[]
  savingsContributions SavingsContribution[]

  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  token        String   @unique
  device       String   @default("Desktop Workstation")
  browser      String   @default("Chrome")
  os           String   @default("Windows 11")
  ipAddress    String   @default("127.0.0.1")
  isCurrent    Boolean  @default(false)
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Task {
  id               String     @id @default(uuid())
  userId           String
  projectId        String?
  title            String
  description      String?    @db.Text
  category         String     @default("General") // Work, Dev, Study/IELTS, Health, Personal
  priority         Priority   @default(NORMAL)
  status           TaskStatus @default(PENDING)
  startDate        DateTime?
  dueDate          DateTime?
  completedAt      DateTime?
  estimatedMinutes Int        @default(30)
  actualMinutes    Int        @default(0)
  recurrence       String     @default("NONE") // NONE, DAILY, WEEKLY, MONTHLY
  tags             String[]   @default([])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  project  Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  subtasks Subtask[]

  @@index([userId, status])
  @@index([userId, priority])
  @@index([userId, dueDate])
  @@index([userId, category])
  @@map("tasks")
}

model Subtask {
  id        String   @id @default(uuid())
  taskId    String
  title     String
  completed Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("subtasks")
}

model CalendarEvent {
  id          String   @id @default(uuid())
  userId      String
  title       String
  description String?  @db.Text
  category    String   @default("WORK") // PERSONAL, EDUCATION, WORK, PROJECT
  startDate   DateTime
  endDate     DateTime
  allDay      Boolean  @default(false)
  location    String?
  projectId   String?
  isRecurring Boolean  @default(false)
  recurrence  String?  // DAILY, WEEKLY, MONTHLY
  reminderMin Int?     @default(15) // Reminder notice in minutes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startDate])
  @@index([userId, category])
  @@map("calendar_events")
}

model Reminder {
  id          String   @id @default(uuid())
  userId      String
  title       String
  dueDateTime DateTime
  isCompleted Boolean  @default(false)
  category    String   @default("General")
  isRecurring Boolean  @default(false)
  recurrence  String?  // DAILY, WEEKLY
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueDateTime])
  @@map("reminders")
}

model FocusSession {
  id              String   @id @default(uuid())
  userId          String
  taskId          String?
  subject         String   @default("Deep Work")
  durationMinutes Int      @default(25)
  completedAt     DateTime @default(now())
  notes           String?  @db.Text
  mode            String   @default("POMODORO") // POMODORO, DEEP_WORK, SHORT_BREAK, LONG_BREAK

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
  @@map("focus_sessions")
}

model Habit {
  id                String   @id @default(uuid())
  userId            String
  name              String
  description       String?
  frequency         String   @default("DAILY")
  targetDaysPerWeek Int      @default(7)
  targetCount       Int      @default(1)
  unit              String   @default("times")
  category          String   @default("DISCIPLINE")
  color             String   @default("#10B981")
  streak            Int      @default(0)
  bestStreak        Int      @default(0)
  archived          Boolean  @default(false)
  reminderTime      String?  // e.g. "08:30"
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs HabitLog[]

  @@index([userId, archived])
  @@map("habits")
}

model HabitLog {
  id          String   @id @default(uuid())
  habitId     String
  userId      String
  date        String   // Format: YYYY-MM-DD for fast index lookup
  completedAt DateTime @default(now())
  count       Int      @default(1)
  notes       String?
  createdAt   DateTime @default(now())

  // Relations
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([habitId, date])
  @@index([userId, date])
  @@map("habit_logs")
}

model WellnessLog {
  id              String   @id @default(uuid())
  userId          String
  date            String   // YYYY-MM-DD
  sleepHours      Float?   @default(7.5)
  exerciseMinutes Int?     @default(45)
  waterGlasses    Int?     @default(8)
  mood            String?  @default("Energized")
  energyLevel     Int?     @default(4)
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("wellness_logs")
}

model Project {
  id            String        @id @default(uuid())
  userId        String
  name          String
  slug          String
  description   String?       @db.Text
  status        ProjectStatus @default(ACTIVE)
  priority      Priority      @default(NORMAL)
  techStack     String[]      @default([])
  repositoryUrl String?
  liveUrl       String?
  progress      Int           @default(0)
  color         String?       @default("#10B981")
  icon          String?
  startDate     DateTime?
  targetDate    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks          Task[]
  devBugs        DevBug[]
  devFeatures    DevFeature[]
  devDocs        DevDoc[]
  devDeployments DevDeployment[]
  devReleases    DevRelease[]

  @@unique([userId, slug])
  @@index([userId, status])
  @@map("projects")
}

model Transaction {
  id          String          @id @default(uuid())
  userId      String
  title       String
  amount      Decimal         @db.Decimal(12, 2)
  type        TransactionType
  category    String
  account     String          @default("Default Account")
  currency    String          @default("USD")
  paymentMethod String        @default("Bank Card")
  date        DateTime        @default(now())
  notes       String?         @db.Text
  tags        String[]        @default([])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([userId, date])
  @@index([userId, category])
  @@map("transactions")
}

model KnowledgeNote {
  id         String   @id @default(uuid())
  userId     String
  title      String
  content    String   @db.Text
  summary    String?  @db.Text
  category   String   @default("General")
  tags       String[] @default([])
  isPinned   Boolean  @default(false)
  isFavorite Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
  @@index([userId, isPinned])
  @@map("knowledge_notes")
}

model Goal {
  id          String          @id @default(uuid())
  userId      String
  title       String
  description String?         @db.Text
  category    String          @default("CAREER") // Education, Career, Finance, Health, Technology, Personal Development, Travel
  timeframe   String          @default("ANNUAL") // SHORT_TERM, LONG_TERM, ANNUAL
  priority    Priority        @default(NORMAL)
  progress    Int             @default(0)
  targetDate  DateTime?
  completedAt DateTime?
  isAchieved  Boolean         @default(false)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relations
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones GoalMilestone[]

  @@index([userId, isAchieved])
  @@index([userId, category])
  @@map("goals")
}

model GoalMilestone {
  id          String    @id @default(uuid())
  goalId      String
  title       String
  isCompleted Boolean   @default(false)
  targetDate  DateTime?
  order       Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("goal_milestones")
}

model VisionItem {
  id         String   @id @default(uuid())
  userId     String
  title      String
  statement  String   @db.Text
  category   String   @default("CAREER") // EDUCATION, CAREER, FINANCE, HEALTH, TECHNOLOGY, TRAVEL
  imageUrl   String?
  targetYear Int?     @default(2027)
  isPinned   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
  @@map("vision_items")
}

model JournalEntry {
  id         String   @id @default(uuid())
  userId     String
  title      String
  content    String   @db.Text
  date       String   // YYYY-MM-DD
  mood       String   @default("Reflective")
  tags       String[] @default([])
  isPrivate  Boolean  @default(false)
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, isArchived])
  @@map("journal_entries")
}

model IeltsPracticeRecord {
  id              String   @id @default(uuid())
  userId          String
  section         String   // "LISTENING", "READING", "WRITING", "SPEAKING"
  title           String
  taskType        String?  // "TASK_1", "TASK_2", "PART_1", "PART_2", "PART_3", "READING_PASSAGE", "SECTION_4"
  prompt          String?  @db.Text
  submission      String?  @db.Text
  bandScore       Float?   @default(8.0)
  durationMinutes Int?     @default(40)
  wordCount       Int?
  feedback        String?  @db.Text
  audioUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, section])
  @@map("ielts_practice_records")
}

model ExamResult {
  id             String   @id @default(uuid())
  userId         String
  examType       String   @default("IELTS_ACADEMIC") // "IELTS_ACADEMIC", "IELTS_GENERAL", "ARABIC_CEFR"
  title          String
  listeningScore Float    @default(8.5)
  readingScore   Float    @default(8.5)
  writingScore   Float    @default(8.0)
  speakingScore  Float    @default(8.5)
  overallBand    Float    @default(8.5)
  date           DateTime @default(now())
  notes          String?  @db.Text
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, examType])
  @@index([userId, date])
  @@map("exam_results")
}

model ArabicPracticeLog {
  id              String   @id @default(uuid())
  userId          String
  skill           String   // "LISTENING", "READING", "WRITING", "SPEAKING", "GRAMMAR"
  topic           String
  cefrLevel       String   @default("B2") // "A1", "A2", "B1", "B2", "C1"
  grammarFocus    String?  // e.g. "I'rab (الإعراب)", "Bab Fa'ala", "Jumla Ismiyya"
  notes           String?  @db.Text
  durationMinutes Int      @default(30)
  date            DateTime @default(now())
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, skill])
  @@map("arabic_practice_logs")
}

model VocabularyCard {
  id                 String    @id @default(uuid())
  userId             String
  word               String    // e.g. "Equivocal", "استراتيجية"
  translation        String    // Uzbek / English meaning e.g. "Noaniq, ikkilamchi", "Strategiya"
  language           String    @default("ENGLISH") // "ENGLISH", "ARABIC"
  difficulty         String    @default("C1") // "A1", "A2", "B1", "B2", "C1", "C2"
  topic              String    @default("Academic") // "Academic", "Architecture", "Science", "Nahw"
  phonetic           String?   // Pronunciation or harakat
  exampleSentence    String?   @db.Text
  exampleTranslation String?   @db.Text
  status             String    @default("NEW") // "NEW", "LEARNING", "REVIEWING", "MASTERED"
  // Spaced Repetition (SM-2 Algorithm parameters)
  repetition         Int       @default(0)
  interval           Int       @default(1) // in days
  easeFactor         Float     @default(2.5)
  nextReviewDate     DateTime  @default(now())
  lastReviewedAt     DateTime?
  reviewCount        Int       @default(0)
  correctCount       Int       @default(0)
  incorrectCount     Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, language])
  @@index([userId, status])
  @@index([userId, nextReviewDate])
  @@map("vocabulary_cards")
}

model StudySession {
  id              String   @id @default(uuid())
  userId          String
  subject         String   @default("IELTS_READING") // "IELTS_READING", "IELTS_WRITING", "IELTS_SPEAKING", "IELTS_LISTENING", "ARABIC_GRAMMAR", "ARABIC_VOCAB", "SOFTWARE_ARCH"
  durationMinutes Int      @default(45)
  notes           String?  @db.Text
  completedAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, completedAt])
  @@map("study_sessions")
}

model DevBug {
  id          String   @id @default(uuid())
  projectId   String
  userId      String
  title       String
  description String?  @db.Text
  severity    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  status      String   @default("OPEN") // OPEN, INVESTIGATING, RESOLVED, CLOSED
  module      String?
  reproSteps  String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([userId, status])
  @@map("dev_bugs")
}

model DevFeature {
  id            String   @id @default(uuid())
  projectId     String
  userId        String
  title         String
  description   String?  @db.Text
  priority      String   @default("P1") // P0, P1, P2, P3
  status        String   @default("BACKLOG") // BACKLOG, PLANNED, IN_DEVELOPMENT, SHIPPED
  targetVersion String?  // e.g. "v1.2"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
  @@index([userId, status])
  @@map("dev_features")
}

model DevDoc {
  id             String   @id @default(uuid())
  projectId      String
  userId         String
  title          String
  category       String   @default("API") // API, ARCHITECTURE, ENVIRONMENT, GUIDE
  endpoint       String?
  method         String?  // GET, POST, PUT, DELETE
  content        String   @db.Text
  requestPayload String?  @db.Text
  responsePayload String? @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, category])
  @@index([userId, category])
  @@map("dev_docs")
}

model DevDeployment {
  id               String   @id @default(uuid())
  projectId        String
  userId           String
  environment      String   @default("PRODUCTION") // PRODUCTION, PREVIEW, STAGING
  commitSha        String?
  commitMessage    String?
  branch           String   @default("main")
  status           String   @default("SUCCESS") // SUCCESS, FAILED, BUILDING
  deploymentUrl    String?
  buildDurationSec Int?
  deployedAt       DateTime @default(now())
  logSnippet       String?  @db.Text
  source           String   @default("MANUAL") // MANUAL, VERCEL, GITHUB_ACTIONS

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, deployedAt])
  @@index([userId, environment])
  @@map("dev_deployments")
}

model DevRelease {
  id          String   @id @default(uuid())
  projectId   String
  userId      String
  version     String   // e.g. "v1.4.0"
  title       String
  changelog   String   @db.Text
  releaseDate DateTime @default(now())
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, releaseDate])
  @@index([userId, version])
  @@map("dev_releases")
}

model DevIntegrationSetting {
  id              String    @id @default(uuid())
  userId          String    @unique
  githubConnected Boolean   @default(false)
  githubUsername  String?
  githubToken     String?
  githubLastSync  DateTime?
  vercelConnected Boolean   @default(false)
  vercelUsername  String?
  vercelToken     String?
  vercelLastSync  DateTime?
  monitoringMode  String    @default("HYBRID") // LIVE, CACHED, MANUAL
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("dev_integration_settings")
}

model Budget {
  id           String   @id @default(uuid())
  userId       String
  category     String   @default("ALL") // "ALL" or specific category e.g. "Food", "Technology"
  month        String   // Format: "YYYY-MM"
  monthlyLimit Decimal  @db.Decimal(12, 2)
  currency     String   @default("USD")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, month])
  @@index([userId, month])
  @@map("budgets")
}

model SavingsGoal {
  id            String   @id @default(uuid())
  userId        String
  name          String
  targetAmount  Decimal  @db.Decimal(12, 2)
  currentAmount Decimal  @default(0) @db.Decimal(12, 2)
  currency      String   @default("USD")
  targetDate    DateTime?
  color         String?  @default("#10B981")
  icon          String?
  category      String   @default("General")
  isCompleted   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions SavingsContribution[]

  @@index([userId, isCompleted])
  @@map("savings_goals")
}

model SavingsContribution {
  id        String   @id @default(uuid())
  goalId    String
  userId    String
  amount    Decimal  @db.Decimal(12, 2)
  note      String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  goal SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([goalId, date])
  @@map("savings_contributions")
}
